{
  "name": "simandupa",
  "version": "1.0.0",
  "description": "Sistem Informasi Manajemen Terpadu MAN 2 Palembang",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && nodemon server.js",
    "dev:frontend": "cd sim-web && npm run dev",
    "build": "cd sim-web && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../sim-web && npm install"
  },
  "keywords": ["sim", "madrasah", "man2palembang", "simandupa"],
  "author": "Jun-D-teach",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}